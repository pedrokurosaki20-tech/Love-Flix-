# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: Chave oficial da API v3 do The Movie Database (TMDB).
# Mantida exclusivamente no servidor (server.ts) para proteger a credencial.
TMDB_API_KEY="YOUR_TMDB_API_KEY"

# LOVEFLIX_BRIDGE_SECRET: Segredo do servidor para assinar e validar chaves de integração
# entre a Love Flix e plataformas externas de sala sincronizada (/api/bridge/*).
LOVEFLIX_BRIDGE_SECRET="YOUR_LOVEFLIX_BRIDGE_SECRET"

