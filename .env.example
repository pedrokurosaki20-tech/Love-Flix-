# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: Chave oficial da API v3 do The Movie Database (TMDB).
# Mantida exclusivamente no servidor (server.ts) para proteger a credencial.
TMDB_API_KEY="YOUR_TMDB_API_KEY"

# LOVEFLIX_BRIDGE_SECRET: Segredo do servidor para assinar e validar chaves de integração
# entre a Love Flix e plataformas externas de sala sincronizada (/api/bridge/*).
LOVEFLIX_BRIDGE_SECRET="YOUR_LOVEFLIX_BRIDGE_SECRET"

# Supabase Auth and PostgreSQL (the anon key is public; the service role key is server-only).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
CONTACT_OTP_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# SMTP delivery for email-change verification codes.
SMTP_HOST="YOUR_SMTP_HOST"
SMTP_PORT="587"
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="Love Flix <no-reply@example.com>"

# Twilio delivery for new-phone verification codes.
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_FROM_NUMBER="+10000000000"

