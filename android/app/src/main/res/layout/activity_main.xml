<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loveflix_bg">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loveflix_bg"
        android:overScrollMode="never" />

    <!-- Dedicated Native Canal 2 Player WebView (positioned dynamically over #SuperCDNContainerVideo) -->
    <com.loveflix.app.Canal2ContainerLayout
        android:id="@+id/canal2Container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <WebView
            android:id="@+id/canal2WebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:overScrollMode="never" />

        <FrameLayout
            android:id="@+id/canal2FloatingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/canal2CloseBtn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/canal2_pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="← Fechar"
                android:textColor="@color/loveflix_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/canal2FullscreenBtn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/canal2_pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Tela cheia"
                android:textColor="@color/loveflix_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </com.loveflix.app.Canal2ContainerLayout>

    <!-- Native Launch Animation Overlay shown on app startup -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <VideoView
            android:id="@+id/splashVideoView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <ProgressBar
            android:id="@+id/splashSlowNetworkSpinner"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/loveflix_crimson"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Offline / Retry Overlay -->
    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loveflix_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/loveflix_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/offline_title"
            android:textColor="@color/loveflix_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/offline_message"
            android:textColor="@color/loveflix_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/loveflix_crimson"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/offline_retry"
            android:textAllCaps="false"
            android:textColor="@color/loveflix_white"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Native Edge-to-Edge Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
